# Agent Server Configuration
# Copy this file to .env and fill in your values

# ===== LLM Provider Configuration =====

# Ollama Configuration
# Host for your local Ollama instance
OLLAMA_HOST=localhost:11434

# Anthropic Configuration
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===== Logging =====
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ===== TTS Configuration =====
# Path to reference audio file for voice cloning (relative to project root or absolute)
# Leave commented out to disable TTS
# TTS_REFERENCE_AUDIO=reference_audio/voice.wav

# Optional: Override ffmpeg path if not on system PATH (auto-detected by default)
# FFMPEG_PATH=/usr/bin/ffmpeg
