{
  "steps": [
    {
      "name": "install",
      "label": "Install",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install_managed_env.ps1"
    },
    {
      "name": "build",
      "label": "Build",
      "command": "npm run build"
    },
    {
      "name": "test",
      "label": "Tests",
      "command": "npm test"
    },
    {
      "name": "deploy",
      "label": "Deploy",
      "command": "uv run --directory agent_server uvicorn agent.api_server:app --host 0.0.0.0 --port {PORT}",
      "healthPath": "/health"
    }
  ]
}
